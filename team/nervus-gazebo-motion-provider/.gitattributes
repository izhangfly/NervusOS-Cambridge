* text=auto eol=lf

# Windows-native entry points.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Generated bundles, simulation meshes, archives, and media are binary.
*.binpb -text
*.STL -text
*.stl -text
*.dae -text
*.glb -text
*.gltf -text
*.zip -text
*.7z -text
*.gz -text
*.png -text
*.jpg -text
*.jpeg -text
*.webp -text
