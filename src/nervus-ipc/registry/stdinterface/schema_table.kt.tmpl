// This file is generated by registry/stdinterface; **don't edit it by hand**.
//
// To regenerate:
//   go test ./registry/stdinterface -run TestUpdateCommittedTable -update
//
// # What this is
//
// The schema hashes of every platform standard interface. RegisterEndpoint must carry one, which the kernel compares byte for byte with the
// Catalog's copy, refusing on a mismatch or when it's empty (nervud internal/endpoint/register.go).
//
// # Why the JVM side reads constants rather than computing them
//
// The hash is sha256(the deterministically encoded FileDescriptorSet). Go computes it in one line with registry.BuildSchemaBundle,
// while the JVM side has no equivalent, and protobuf-java doesn't guarantee byte-for-byte equality with Go's Deterministic encoding,
// which is exactly what's needed here. So Go computes it once and writes it out, and both sides read the same
// generated output, the same shape as the golden vectors.
//
// Changing any standard interface's .proto without rerunning generation turns nervus-ipc's CI red
// (TestCommittedTableMatches).

package io.github.nervusos.ipc.v1

/** The schema hash table of platform standard interfaces. */
object StdInterfaceSchema {

    /** "<interface_id>@<major>" -> the schema hash in hex. */
    private val hex: Map<String, String> = mapOf(
{{- range .Entries}}
        "{{.Key}}" to
            "{{.Hex}}",
{{- end}}
    )

    /**
     * Get a standard interface's schema hash.
     *
     * Throws when not found, and **never returns an empty array**: an empty hash is refused by the kernel, with the symptom
     * "interface schema hash does not match the catalog", far from the real cause, "this interface isn't in the table".
     * Failing here makes the error message point at the right place.
     */
    fun hashOf(interfaceId: String, major: Int = 1): ByteArray {
        val key = "$interfaceId@$major"
        val value = hex[key]
            ?: throw IllegalArgumentException(
                "no committed schema hash for '$key'; " +
                    "add it to registry/stdinterface in nervus-ipc and regenerate",
            )
        return ByteArray(value.length / 2) { i ->
            value.substring(i * 2, i * 2 + 2).toInt(16).toByte()
        }
    }

    /** Every key registered in the table, for diagnostics. */
    fun keys(): Set<String> = hex.keys
}
