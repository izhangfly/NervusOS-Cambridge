# All source and scripts use LF. The build scripts run on the target (Linux), and CRLF makes
# the shebang fail to parse with a baffling "interpreter not found" error.
*.go   text eol=lf
*.sh   text eol=lf
*.json text eol=lf
*.in   text eol=lf
*.md   text eol=lf
go.mod text eol=lf
go.sum text eol=lf
