[Unit]
Description=GPT Arm: overhead camera server (Surface rear camera on 127.0.0.1:8798)

[Service]
User=ian
SupplementaryGroups=video
# Fixed exposure: auto-exposure meters the dark floor and clips the white table. Tune with --controls.
Environment="OVERHEAD_CONTROLS=ae-enable=false exposure-time=30000 analogue-gain=4"
ExecStart=/usr/bin/python3 /opt/gptarm/overhead_cam.py
Restart=always
RestartSec=3s
SyslogIdentifier=gptarm-overhead

[Install]
WantedBy=multi-user.target
