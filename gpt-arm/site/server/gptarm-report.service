[Unit]
Description=GPT Arm report (static site, own Caddy process, port 8930)
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=gptarm-report
Environment=XDG_DATA_HOME=/var/lib/gptarm-report XDG_CONFIG_HOME=/var/lib/gptarm-report
ExecStart=/usr/bin/caddy run --config /etc/gptarm-report/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/srv/gptarm-report /etc/gptarm-report

[Install]
WantedBy=multi-user.target
