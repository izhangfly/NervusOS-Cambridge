// Lets the desktop user open and quit NervusOS without a password: start, stop
// and restart nervud, the PiPER driver and the ACT engine, and nothing else.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "@USER@") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if ((unit == "nervud.service" || unit == "nervus-piper.service" || unit == "nervus-act.service" || unit == "nervus-llm-arm.service") &&
            (verb == "start" || verb == "stop" || verb == "restart")) {
            return polkit.Result.YES;
        }
    }
});
